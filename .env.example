# Module-specific DB URLs (audit H-05: billing/drug-database/prescriber-directory
# bypass shared/config.py with module-local session factories).
# These should point to the same database as DATABASE_URL until the modules are
# migrated to use shared.db.session (tracked as audit finding CR-05/H-05).
BILLING_DATABASE_URL=postgresql://infinityrx:infinityrx_dev@localhost:5432/infinityrx
DRUG_DB_DATABASE_URL=postgresql://infinityrx:infinityrx_dev@localhost:5432/infinityrx
PRESCRIBER_DB_URL=postgresql://infinityrx:infinityrx_dev@localhost:5432/infinityrx
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://infinityrx:infinityrx_dev@localhost:5672/

JWT_SECRET=change_me_to_a_value_with_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./var/files

SMTP_HOST=localhost
SMTP_PORT=1025

OIG_EXCLUSION_URL=https://oig.hhs.gov/exclusions/downloadables/UPDATED/UPDATED.csv
SAM_API_KEY=

MAX_UPLOAD_BYTES=104857600

# Inter-module HTTP client base URLs (medical-claims → downstream services)
# Ports are convention-only for local dev; in AKS use Kubernetes service names.
PHARMACY_DIRECTORY_URL=http://localhost:8003
MEMBER_MANAGEMENT_URL=http://localhost:8004
DRUG_DATABASE_URL=http://localhost:8005

# Encryption — 32-byte key, base64 encoded
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_PROVIDER=env
ENCRYPTION_KEY_ACTIVE=generate-me-with-python-fernet
ENCRYPTION_KEY_ACTIVE_ID=v1
